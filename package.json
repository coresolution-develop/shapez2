{
  "name": "shapez2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:presets": "python3 scripts/extractPresets.py > src/lib/shapez/presets.json",
    "gen:vectors": "python3 scripts/genVectors.py > src/lib/shapez/__tests__/opVectors.json",
    "gen:buildings": "python3 scripts/extractBuildings.py > src/lib/shapez/buildings.json",
    "gen:blueprints": "python3 scripts/genBlueprintVectors.py > src/lib/shapez/__tests__/blueprintVectors.json",
    "gen:progression": "python3 scripts/extractProgression.py > src/lib/shapez/progression.json",
    "gen:names": "python3 scripts/extractKoreanNames.py > src/lib/shapez/namesKo.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "next": "16.3.1",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@9.15.4"
}
